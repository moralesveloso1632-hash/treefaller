    "notes": [
      {
        "ids": [
          "handle:ChunkRef::set_transient_forced"
        ],
        "why": "A mod can hold a chunk for one operation, such as finding a random teleport destination, without the ticket being saved and reopened on restart. TicketOwner and its codec are unchanged.",
        "migrate": "Additive. Transient tickets are not listed by mod_forced_chunks or handed to validate_tickets."
      },
      {
        "ids": [
          "method:prelude::PlayersServerHost::mod_command_raw"
        ],
        "why": "Additive host method: a run_mod_command listener reads the untrusted text of the leaf command it was given, after execute ... run and return run, without changing CommandInvocation's layout or the run_mod_command fingerprint.",
        "migrate": "Additive. None outside a run_mod_command listener."
      }
    ]
